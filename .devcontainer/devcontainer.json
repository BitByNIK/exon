// Dev container for exon. Your own variant, with the toolbox and your other projects, goes in the
// git-ignored .devcontainer/local/: `exon dev init` makes it.
{
  "name": "exon",
  "build": { "dockerfile": "Dockerfile" },
  // Delve (dlv) needs ptrace to debug processes inside the container.
  "capAdd": ["SYS_PTRACE"],
  "securityOpt": ["seccomp=unconfined"],
  // Use the repo's git hooks (.githooks/), which format code before each commit.
  "postCreateCommand": "git config core.hooksPath .githooks"
}
