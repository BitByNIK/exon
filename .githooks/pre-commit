#!/bin/sh
# Formats the staged Go and Markdown files (rules in lefthook.yml).
# Needs lefthook, which the dev container has. Without it this does nothing on
# purpose: it never falls back to other tools.
if command -v lefthook >/dev/null 2>&1; then
  exec lefthook run pre-commit "$@"
fi
echo "pre-commit: lefthook not found, formatting skipped (install lefthook, or use the dev container)"
